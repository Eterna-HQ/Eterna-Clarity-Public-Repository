{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Small Business Records Taxonomy schema",
  "type": "object",
  "required": [
    "title",
    "short_name",
    "namespace",
    "version",
    "status",
    "maintainer",
    "classification_principle",
    "accountability_test",
    "small_business_note",
    "tie_breakers",
    "recommended_metadata",
    "categories"
  ],
  "properties": {
    "title": {"type": "string"},
    "short_name": {"const": "OSBRT"},
    "namespace": {"const": "osbrt"},
    "version": {"type": "string"},
    "status": {"enum": ["public_review_candidate", "released", "superseded"]},
    "maintainer": {"type": "string"},
    "license": {"type": ["string", "null"]},
    "classification_principle": {"type": "string"},
    "accountability_test": {"type": "string"},
    "small_business_note": {"type": "string"},
    "tie_breakers": {"type": "array", "items": {"type": "string"}},
    "recommended_metadata": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "purpose"],
        "properties": {
          "field": {"type": "string"},
          "purpose": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "categories": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["id", "name", "definition", "responsibility", "examples", "use_when", "handling_cue", "review_trigger", "related_categories"],
        "properties": {
          "id": {"type": "string", "pattern": "^osbrt\\.[a-z0-9_]+"},
          "name": {"type": "string"},
          "definition": {"type": "string"},
          "responsibility": {"type": "string"},
          "examples": {"type": "array", "items": {"type": "string"}},
          "use_when": {"type": "string"},
          "handling_cue": {"enum": ["context_dependent", "often_sensitive", "highly_sensitive"]},
          "review_trigger": {"type": "string"},
          "related_categories": {"type": "array", "items": {"type": "string", "pattern": "^osbrt\\.[a-z0-9_]+"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
